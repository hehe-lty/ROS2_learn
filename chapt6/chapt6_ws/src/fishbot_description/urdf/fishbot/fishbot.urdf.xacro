<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fishbot">
<!-- 身体 -->
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/base.urdf.xacro"/>
<!-- 传感器 -->
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/sensor/laser.urdf.xacro"/>
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/sensor/camera.urdf.xacro"/>
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/sensor/imu.urdf.xacro"/>
<!-- 执行器 -->
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/actuator/wheel.urdf.xacro"/>
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/actuator/caster.urdf.xacro"/>

<xacro:base_xacro length="0.12" radius="0.10"/>
<xacro:laser_xacro laser_name="laser" xyz="0.0 0.0 0.10" rpy="0.0 0.0 0.0"/>
<xacro:camera_xacro camera_name="camera" xyz="0.10 0.0 0.075" rpy="0.0 0.0 0.0"/>
<xacro:imu_xacro imu_name="imu" xyz="0.0 0.0 0.02" rpy="0.0 0.0 0.0"/>

<xacro:wheel_xacro wheel_name="left_wheel" xyz="0.0 0.10 -0.06" rpy="0.0 0.0 0.0"/>
<xacro:wheel_xacro wheel_name="right_wheel" xyz="0.0 -0.10 -0.06" rpy="0.0 0.0 0.0"/>
<xacro:caster_xacro caster_name="front_caster" xyz="0.08 0.0 -0.076" rpy="0.0 0.0 0.0"/>
<xacro:caster_xacro caster_name="rear_caster" xyz="-0.08 0.0 -0.076" rpy="0.0 0.0 0.0"/>

</robot>

<!-- ros2 launch fishbot_description display_robot.launch.py urdf_path:=/home/rick/ROS2_learn/chapt6/chapt6_ws/src/fishbot_description/urdf/fishbot/fishbot.urdf.xacro -->