<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="camera_xacro" params="camera_name xyz rpy">
        <!-- 机器的摄像头 -->
        <link name="${camera_name}_link">
        <!-- 部件的外观描述 -->
            <visual>
            <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.02 0.10 0.02"/>
                </geometry>
                <material name="blue">
                    <color rgba="0.0 0.0 1.0 0.5"/>
                </material>
            </visual>
        </link>
        <!-- 机器人的关节，用于连接camera_link和base_link -->
        <joint name="${camera_name}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${camera_name}_link"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
    </xacro:macro>

</robot>